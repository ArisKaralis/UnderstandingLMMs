{"nodes": [{"id": "vision", "label": "Vision encoder", "kind": "vision", "level": "macro", "parent": null, "inputs": {"pixels": [["C", 3], ["H", 256], ["W", 160]]}, "outputs": {"vision_embeds": [["N_v", 40], ["d", 128]]}, "weights": {}, "params": 0, "flops": 0, "op": "", "eq": "", "info": "SigLIP-2-style ViT (4 blocks, width 64). The image is resized to multiples of 32px, cut into 16\u00d716 patches (16\u00d710=160 patches), encoded, then every 2\u00d72 group is merged into one LLM token (40 tokens).", "ref": "Qwen3-VL Tech Report (arXiv 2511.21631)", "meta": {}}, {"id": "vision.preprocess", "label": "Smart resize + patchify", "kind": "preprocess", "level": "op", "parent": "vision", "inputs": {"image": [["C", 3], ["H\u2080", 256], ["W\u2080", 160]]}, "outputs": {"pixel_values": [["N_p", 160], ["C\u00b7T\u00b7p\u00b7p", 1536]], "grid_thw": [["3", 3]]}, "weights": {}, "params": 0, "flops": 0, "op": "img = resize(img, to=(256,160))            # multiples of patch*merge = 32\nimg = (img/255 - 0.5) / 0.5                    # mean=std=0.5\nframes = repeat(img, T=2)                   # a still image is 2 identical frames\npatches = rearrange(frames, 'c (t pt) (h ph) (w pw) -> (t h w) (c pt ph pw)', pt=2, ph=16, pw=16)\n# patch order is grouped so each 2x2 merge window is contiguous", "eq": "N_p = \\tfrac{T}{2}\\cdot\\tfrac{H}{16}\\cdot\\tfrac{W}{16}", "info": "No learned weights. Dynamic resolution: the patch count follows the image size, bounded by min/max pixels.", "ref": "", "meta": {"grid_thw": [1, 16, 10], "resized": [256, 160]}}, {"id": "vision.patch_embed", "label": "Patch embedding (Conv3d)", "kind": "linear", "level": "op", "parent": "vision", "inputs": {"pixel_values": [["N_p", 160], ["C\u00b7T\u00b7p\u00b7p", 1536]]}, "outputs": {"x": [["N_p", 160], ["d_v", 64]]}, "weights": {"proj.weight": [["d_v", 64], ["C", 3], ["T", 2], ["p", 16], ["p", 16]]}, "params": 98368, "flops": 31457280, "op": "x = Conv3d(kernel=stride=(2,16,16))(patches)  # == patches @ W.T + b", "eq": "x_i = W_{pe}\\,\\mathrm{vec}(\\text{patch}_i) + b", "info": "A stride-equal Conv3d is exactly a linear projection of each flattened 2\u00d716\u00d716\u00d73 patch.", "ref": "", "meta": {}}, {"id": "vision.pos_embed", "label": "Absolute pos-emb (bilinear interp.)", "kind": "embedding", "level": "op", "parent": "vision", "inputs": {"x": [["N_p", 160], ["d_v", 64]]}, "outputs": {"x": [["N_p", 160], ["d_v", 64]]}, "weights": {"pos_embed.weight": [["P", 2304], ["d_v", 64]]}, "params": 147456, "flops": 0, "op": "grid = pos_embed.weight.view(48,48,d_v)\npe = bilinear_interp(grid, to=(16,10))\nx = x + pe.flatten(0,1)", "eq": "", "info": "A learned 48\u00d748 position grid is resampled to the image's 16\u00d710 patch grid (CoMP-style), so any resolution works.", "ref": "", "meta": {}}, {"id": "vision.rope2d", "label": "2D RoPE (h, w)", "kind": "rope", "level": "op", "parent": "vision", "inputs": {"pos_ids": [["N_p", 160], ["2", 2]]}, "outputs": {"cos,sin": [["N_p", 160], ["d_h", 16]]}, "weights": {}, "params": 0, "flops": 0, "op": "half of each head's rotary dims rotate with the row index, half with the column index", "eq": "\\mathrm{RoPE}(q)_{[h\\text{-dims}]}\\!\\propto\\! e^{i\\,\\theta_j\\,\\text{row}},\\;\\mathrm{RoPE}(q)_{[w\\text{-dims}]}\\!\\propto\\! e^{i\\,\\theta_j\\,\\text{col}}", "info": "", "ref": "", "meta": {}}, {"id": "vision.blocks", "label": "ViT blocks \u00d74", "kind": "group", "level": "group", "parent": "vision", "inputs": {"x": [["N_p", 160], ["d_v", 64]]}, "outputs": {"x": [["N_p", 160], ["d_v", 64]]}, "weights": {}, "params": 133888, "flops": 0, "op": "", "eq": "", "info": "", "ref": "", "meta": {}}, {"id": "vision.block.0", "label": "ViT block 0", "kind": "vit_block", "level": "block", "parent": "vision.blocks", "inputs": {"x": [["N_p", 160], ["d_v", 64]]}, "outputs": {"x": [["N_p", 160], ["d_v", 64]]}, "weights": {}, "params": 33472, "flops": 17039360, "op": "", "eq": "x \\leftarrow x + \\mathrm{Attn}(\\mathrm{LN}(x));\\quad x \\leftarrow x + \\mathrm{MLP}(\\mathrm{LN}(x))", "info": "", "ref": "", "meta": {"index": 0, "deepstack_tap": false}}, {"id": "vision.block.0.norm1", "label": "LayerNorm", "kind": "norm", "level": "op", "parent": "vision.block.0", "inputs": {"x": [["N_p", 160], ["d_v", 64]]}, "outputs": {"x\u0302": [["N_p", 160], ["d_v", 64]]}, "weights": {}, "params": 128, "flops": 0, "op": "x\u0302 = (x-\u03bc)/\u03c3 \u00b7 \u03b3 + \u03b2", "eq": "", "info": "", "ref": "", "meta": {}}, {"id": "vision.block.0.attn.qkv", "label": "QKV projection", "kind": "linear", "level": "op", "parent": "vision.block.0", "inputs": {"x\u0302": [["N_p", 160], ["d_v", 64]]}, "outputs": {"q,k,v": [["3", 3], ["H", 4], ["N_p", 160], ["d_h", 16]]}, "weights": {"qkv.weight": [["3\u00b7d_v", 192], ["d_v", 64]]}, "params": 12480, "flops": 3932160, "op": "q, k, v = (x\u0302 @ W_qkv.T + b).view(N_p, 3, H, d_h).unbind(1)", "eq": "", "info": "", "ref": "", "meta": {}}, {"id": "vision.block.0.attn.sdpa", "label": "Bidirectional attention", "kind": "attention", "level": "op", "parent": "vision.block.0", "inputs": {"q,k,v": [["H", 4], ["N_p", 160], ["d_h", 16]]}, "outputs": {"o": [["N_p", 160], ["d_v", 64]]}, "weights": {}, "params": 0, "flops": 6553600, "op": "q, k = rope2d(q), rope2d(k)\nscores = einsum('hqd,hkd->hqk', q, k) / sqrt(d_h)   # [H, N_p, N_p]\np = softmax(scores, -1)   # no causal mask; masked per image via cu_seqlens\no = einsum('hqk,hkd->qhd', p, v).reshape(N_p, d_v)", "eq": "\\mathrm{softmax}\\!\\left(\\frac{QK^\\top}{\\sqrt{d_h}}\\right)V", "info": "", "ref": "", "meta": {"score_shape": [4, 160, 160]}}, {"id": "vision.block.0.attn.proj", "label": "Output projection", "kind": "linear", "level": "op", "parent": "vision.block.0", "inputs": {"o": [["N_p", 160], ["d_v", 64]]}, "outputs": {"\u0394x": [["N_p", 160], ["d_v", 64]]}, "weights": {"proj.weight": [["d_v", 64], ["d_v", 64]]}, "params": 4160, "flops": 1310720, "op": "x = x + o @ W_o.T + b", "eq": "", "info": "", "ref": "", "meta": {}}, {"id": "vision.block.0.norm2", "label": "LayerNorm", "kind": "norm", "level": "op", "parent": "vision.block.0", "inputs": {"x": [["N_p", 160], ["d_v", 64]]}, "outputs": {"x\u0302": [["N_p", 160], ["d_v", 64]]}, "weights": {}, "params": 128, "flops": 0, "op": "", "eq": "", "info": "", "ref": "", "meta": {}}, {"id": "vision.block.0.mlp", "label": "MLP (gelu_pytorch_tanh)", "kind": "mlp", "level": "op", "parent": "vision.block.0", "inputs": {"x\u0302": [["N_p", 160], ["d_v", 64]]}, "outputs": {"\u0394x": [["N_p", 160], ["d_v", 64]]}, "weights": {"fc1": [["d_ff", 128], ["d_v", 64]], "fc2": [["d_v", 64], ["d_ff", 128]]}, "params": 16576, "flops": 5242880, "op": "x = x + fc2(gelu_tanh(fc1(x\u0302)))   # 64 \u2192 128 \u2192 64", "eq": "", "info": "", "ref": "", "meta": {}}, {"id": "vision.block.1", "label": "ViT block 1", "kind": "vit_block", "level": "block", "parent": "vision.blocks", "inputs": {"x": [["N_p", 160], ["d_v", 64]]}, "outputs": {"x": [["N_p", 160], ["d_v", 64]]}, "weights": {}, "params": 33472, "flops": 17039360, "op": "", "eq": "x \\leftarrow x + \\mathrm{Attn}(\\mathrm{LN}(x));\\quad x \\leftarrow x + \\mathrm{MLP}(\\mathrm{LN}(x))", "info": "", "ref": "", "meta": {"index": 1, "deepstack_tap": false}}, {"id": "vision.block.1.norm1", "label": "LayerNorm", "kind": "norm", "level": "op", "parent": "vision.block.1", "inputs": {"x": [["N_p", 160], ["d_v", 64]]}, "outputs": {"x\u0302": [["N_p", 160], ["d_v", 64]]}, "weights": {}, "params": 128, "flops": 0, "op": "x\u0302 = (x-\u03bc)/\u03c3 \u00b7 \u03b3 + \u03b2", "eq": "", "info": "", "ref": "", "meta": {}}, {"id": "vision.block.1.attn.qkv", "label": "QKV projection", "kind": "linear", "level": "op", "parent": "vision.block.1", "inputs": {"x\u0302": [["N_p", 160], ["d_v", 64]]}, "outputs": {"q,k,v": [["3", 3], ["H", 4], ["N_p", 160], ["d_h", 16]]}, "weights": {"qkv.weight": [["3\u00b7d_v", 192], ["d_v", 64]]}, "params": 12480, "flops": 3932160, "op": "q, k, v = (x\u0302 @ W_qkv.T + b).view(N_p, 3, H, d_h).unbind(1)", "eq": "", "