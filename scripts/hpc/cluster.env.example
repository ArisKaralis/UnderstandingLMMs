# Cluster-specific settings. On the HPC:
#
#   cp scripts/hpc/cluster.env.example scripts/hpc/cluster.env
#
# then edit cluster.env. It is gitignored: it never leaves the HPC and `git pull` won't overwrite it.
# Every setup script and .slurm job sources it.

# The Python 3.12 module (list them with: module avail python)
# module load <python module name>
# Cluster python modules often set PYTHONPATH to their own site-packages, which breaks the venv's pip:
unset PYTHONPATH

# Big downloads go to scratch (model weights, captured traces). Same values as in MLLM_Testing.
export HF_HOME=/scratch/$USER/hf_cache
export DATA_DIR=/scratch/$USER/datasets
# The MLLM_Testing checkout (VLIR loaders, r3 crop loop, judge rules are imported from it)
export MLLM_TESTING_DIR=$HOME/MLLM_Testing
# VLIR download root (default: $DATA_DIR/VLIR)
# export VLIR_ROOT=$DATA_DIR/VLIR
# Where bundles / training runs are written (large: 20-500 MB per bundle). Copy back what you want to view.
export TRACE_DIR=/scratch/$USER/understanding_lmms/traces
export TRAIN_DIR=/scratch/$USER/understanding_lmms/training
# The venv (~6 GB) lives on scratch and is linked as .venv (home quota is small)
export VENV_DIR=/scratch/$USER/venvs/understanding_lmms
